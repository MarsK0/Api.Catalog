<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>96891985-3da7-4268-b467-15b3ebb67ac5</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
